# MongoDB connection string from your MongoDB Atlas project
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/YOUR_DATABASE?retryWrites=true&w=majority

# Set a unique random secret (at least 32 characters)
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Private admin login credentials - never expose these as NEXT_PUBLIC variables
ADMIN_USERNAME=choose-an-admin-username
ADMIN_PASSWORD=choose-a-long-unique-password

# Public canonical website URL (optional locally; required for production metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional multilingual property AI assistant
OPENAI_API_KEY=replace-with-your-server-side-openai-api-key
OPENAI_MODEL=gpt-5-mini
